# BiMark backend production template (copy → backend/.env on server).
# install.sh / deploy.sh fill most of these automatically.

SECRET_KEY=change-me-generate-with-openssl-rand-hex-48
DEBUG=False
SECURE_SSL_REDIRECT=False

ALLOWED_HOSTS=maintest.site,www.maintest.site,127.0.0.1,localhost

# Sub-path on shared domain (empty for root domain / bimark.org)
FORCE_SCRIPT_NAME=/bimark

CSRF_TRUSTED_ORIGINS=https://maintest.site,http://maintest.site
CORS_ALLOWED_ORIGINS=https://maintest.site,http://maintest.site

# PostgreSQL (must match role password created by install.sh)
DATABASE_URL=postgres://bimark_user:CHANGE_ME@127.0.0.1:5432/bimark_db

# Optional
# CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# RESEND_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox
# TRIPLEA_CLIENT_ID=
# TRIPLEA_CLIENT_SECRET=
# TRIPLEA_MERCHANT_KEY=
# TRIPLEA_WEBHOOK_SECRET=
# TRIPLEA_MODE=sandbox

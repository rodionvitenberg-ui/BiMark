# BiMark Next.js (`next start`) — generated by deploy scripts
# Placeholders: __APP_USER__ __APP_GROUP__ __APP_DIR__ __FE_PORT__ __APP_NAME__
#
# Hardening intentionally light: ProtectSystem/PrivateTmp caused hard-to-debug
# hangs on some VPS images when Next touches cache/fonts under restricted paths.

[Unit]
Description=BiMark Next.js Frontend
After=network.target
Wants=network.target

[Service]
Type=simple
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__APP_DIR__/frontend
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=__FE_PORT__
# next start reads .env.production; NEXT_PUBLIC_* baked at build time
ExecStart=/usr/bin/node __APP_DIR__/frontend/node_modules/next/dist/bin/next start -H 127.0.0.1 -p __FE_PORT__
Restart=always
RestartSec=3
TimeoutStartSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=__APP_NAME__-frontend

[Install]
WantedBy=multi-user.target

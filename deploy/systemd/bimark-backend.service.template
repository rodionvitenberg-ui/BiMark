# BiMark Django (Gunicorn) — generated by deploy scripts
# Placeholders: __APP_USER__ __APP_GROUP__ __APP_DIR__ __BE_PORT__ __APP_NAME__

[Unit]
Description=BiMark Django API (Gunicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__APP_DIR__/backend
EnvironmentFile=__APP_DIR__/backend/.env
ExecStart=__APP_DIR__/backend/venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:__BE_PORT__ \
    --workers 2 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    --name __APP_NAME__-backend
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__APP_DIR__/backend/media __APP_DIR__/backend/staticfiles

[Install]
WantedBy=multi-user.target
